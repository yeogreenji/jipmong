# 집몽(JIPMONG) 환경 변수 — 이름과 용도만 적습니다. 실제 값은 절대 저장소에 올리지 않습니다.

# ── 프런트엔드 (Vite는 VITE_ 접두사만 브라우저에 노출합니다) ──────────────
# 배포 주소 (예: https://jipmong.vercel.app). 공유 카드·문의 링크에 사용합니다.
VITE_SITE_URL=

# 앱 표시 이름 (기본: 집몽)
VITE_APP_NAME=집몽

# 샘플 데이터 사용 여부. 실거래가 연동 전에는 true로 두고 화면에 '샘플' 배지를 표시합니다.
# 절대 false로 바꾼 채 샘플 데이터를 실제 시세처럼 보여주지 마세요.
VITE_USE_SAMPLE_DATA=true

# ── 서버 전용 (Vercel Functions) — VITE_ 접두사를 붙이지 마세요 ─────────────
# 국토교통부 아파트/오피스텔 매매·전세 실거래가 공개 API 서비스 키 (data.go.kr)
# 발급 전에는 비워 두면 /api/health가 configured:false 로 응답하고 화면은 샘플 모드로 동작합니다.
MOLIT_TRADE_API_KEY=

# (선택) 샘플/실데이터 모드를 서버에서 강제할 때 사용합니다. 기본값 sample
DATA_MODE=sample
